# Copy this file to .env and fill in real values. Never commit .env.
# Variables starting with VITE_ are bundled into the public website code,
# so never put secrets in them.

# Address the contact form opens a pre-filled email to.
VITE_CONTACT_EMAIL=contact@example.com

# Ports on your computer for the dev server and the preview server
# (docker compose only). Change them if another app already uses them.
DEV_PORT=5173
PREVIEW_PORT=4173
